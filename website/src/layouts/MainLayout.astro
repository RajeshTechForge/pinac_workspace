---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.tsx";
import { getSession } from "../lib/auth";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Pinac Workspace",
  description = "Privacy-oriented desktop AI chat client.",
} = Astro.props;

const currentPath = Astro.url.pathname;

// Resolve session server-side so the Navbar knows whether to show the
// profile avatar or the guest Login / Sign-Up buttons.
const session = await getSession(Astro.request);
const navUser = session?.user
  ? {
      name:
        (session.user.user_metadata?.full_name as string | undefined) ??
        session.user.email ??
        "User",
      email: session.user.email ?? "",
      avatarUrl:
        (session.user.user_metadata?.avatar_url as string | undefined) ?? null,
    }
  : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-void-800 font-sans text-star-200 antialiased">
    <div class="bg-system" aria-hidden="true">
      <div class="cosmic-bg">
        <div class="nebula-orb primary"></div>
        <div class="nebula-orb secondary"></div>
        <div class="nebula-orb tertiary"></div>
      </div>
      <div class="starfield"></div>
      <div class="space-grid"></div>
      <div class="noise-overlay"></div>
    </div>

    <!-- Fixed navbar sits outside z-10 stacking context so fixed positioning stacks correctly -->
    <Navbar currentPath={currentPath} githubStars={35} user={navUser} client:load />

    <!-- All page content sits above the background layers -->
    <div class="relative z-10 flex min-h-screen flex-col">
      <main class="flex-1">
        <slot />
      </main>
    </div>
  </body>
</html>
