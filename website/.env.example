# =============================================================================
# PINAC WORKSPACE — WEBSITE ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Production secrets are injected via platform-native secret managers
# =============================================================================

# Public base URL of this application (no trailing slash).
WORKOS_APP_BASE_URL=http://localhost:4321

# Used to seal/unseal the session cookie. Must be ≥32 chars.
# Generate a new one with: openssl rand -hex 32
WORKOS_COOKIE_PASSWORD=

# Where to send the user after a successful OAuth callback.
# Defaults to /dashboard.
WORKOS_POST_LOGIN_ROUTE=

# Set to false only for local dev over http://localhost so the
# secure flag is omitted and the browser will store the cookie.
# Defaults to true.
WORKOS_COOKIE_SECURE=

# =============================================================================

# Server-only WorkOS secret key. Never expose to the client.
WORKOS_API_KEY=

# Your WorkOS client ID.
WORKOS_CLIENT_ID=
