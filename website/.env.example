# =============================================================================
# PINAC WORKSPACE — WEBSITE ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Production secrets are injected via platform-native secret managers
# =============================================================================

# Public base URL of this application (no trailing slash).
APP_BASE_URL=http://localhost:4321

# Where to send the user after a successful login / OAuth callback.
# Defaults to /dashboard.
POST_LOGIN_ROUTE=/dashboard

# Set to false only for local dev over http://localhost so the
# secure flag is omitted and the browser will store the cookie.
# Defaults to true.
COOKIE_SECURE=false

# =============================================================================
# SUPABASE AUTHENTICATION
# =============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=

# Supabase's Publishable Key (safe for client/SSR)
SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (Server-only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=
